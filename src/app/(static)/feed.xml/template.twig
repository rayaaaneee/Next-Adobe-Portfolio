<?xml version="1.0" encoding="UTF-8" ?>
<rss version="2.0">
  <channel>
    <title>{{ name }} Portfolio &amp; Blog</title>
    <link>{{ domain }}</link>
    <description>Latest posts from my portfolio and blog</description>
    <language>{{ lang }}</language>
    <lastBuildDate>{{ lastUpdate }}</lastBuildDate>
    <generator>Next.js + Twig</generator>
    <managingEditor>{{ email }} ({{ name }})</managingEditor>
    <webMaster>{{ email }}</webMaster>
    <ttl>60</ttl>
    <copyright>© {{ currentYear }} {{ name }}</copyright>
    <image>
      <url>{{ domain }}{{ logo }}</url>
      <title>{{ name }} Logo</title>
      <link>{{ domain }}</link>
    </image>

    {% for blog in blogs %}
        <item>
            <title>{{ blog.title }}</title>
            <link>{{ domain }}/blog/{{ blog.id }}</link>
            <guid isPermaLink="true">{{ domain }}/blog/{{ blog.id }}</guid>
            <pubDate>{{ blog.date }}</pubDate>
            <description>{{ blog.summary }}</description>
            <author>{{ email }} ({{ name }})</author>
            {% for tag in blog.tags %}
                <category>{{ tag }}</category>
            {% endfor %}
        </item>
    {% endfor %}

  </channel>
</rss>
