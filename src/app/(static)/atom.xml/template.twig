<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
    <title>Rayane Merlin Portfolio &amp; Blog</title>
    <link href="{{ domain }}" />
    <link href="{{ domain }}/atom.xml" rel="self" />
    <updated>{{ lastUpdate }}</updated>
    <id>{{ domain }}</id>
    <author>
        <name>Rayane Merlin</name>
        <email>{{ email }}</email>
    </author>
    <generator>Next.js + Twig</generator>

    {% for blog in blogs %}
        <entry>
            <title>{{ blog.title }}</title>
            <link href="{{ domain }}/blog/{{ blog.id }}" />
            <id>{{ domain }}/blog/{{ blog.id }}</id>
            <updated>{{ blog.date }}</updated>
            <summary>{{ blog.summary }}</summary>
            <author>
                <name>Rayane Merlin</name>
                <email>{{ email }}</email>
            </author>
            {% if blog.tags %}
                {% for tag in blog.tags %}
                    <category term="{{ tag }}" />
                {% endfor %}
            {% endif %}
        </entry>
    {% endfor %}
</feed>
